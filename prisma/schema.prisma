generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshSessions RefreshTokenSession[]
  watchProgress   WatchProgress[]
  followedSeries  FollowedSeries[]
}

model RefreshTokenSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SeriesStatus {
  WATCHING
  DROPPED
  COMPLETED
}

model FollowedSeries {
  id        String       @id @default(cuid())
  userId    String
  seriesId  String
  status    SeriesStatus @default(WATCHING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
}

model Series {
  id          String   @id @default(cuid())
  title       String
  externalIds Json?
  overview    String?
  posterUrl   String?
  in_prod     Boolean?
  status      String?
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episodes  Episode[]
  followers FollowedSeries[]

}

model Episode {
  id            String    @id @default(cuid())
  seriesId      String
  externalIds   Json?
  seasonNumber  Int
  episodeNumber Int
  runtime       Int?
  title         String?
  airDate       DateTime?
  posterUrl     String?
  overview      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  series        Series          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  watchProgress WatchProgress[]

  @@unique([seriesId, seasonNumber, episodeNumber])

}

model WatchProgress {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  watchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}
